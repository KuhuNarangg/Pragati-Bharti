PROJECT_NAME="Document Intelligence & Question Extraction Service"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="super-secret-jwt-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_intel_db
DATABASE_URL=postgresql://postgres:postgres@db:5432/doc_intel_db

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=25
